# Razorpay Test Mode keys from the Razorpay Dashboard. Never commit a real .env.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_secret

# Set this to the secret configured for POST /payments/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
RAZORPAY_CURRENCY=INR
CHECKOUT_NAME=UPI VoicePay

# Sarvam AI key used for speech-to-text (Saaras) and text-to-speech (Bulbul).
# Create the key in the Sarvam dashboard. Keep the real key only in .env.
SARVAM_API_KEY=replace_with_sarvam_api_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE_CODE=unknown
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=24000
